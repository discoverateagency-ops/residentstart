# Copy to web/.env and fill in. Never commit .env.

# --- Database (Postgres; e.g. a free Supabase project) ---
DATABASE_URL='postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1'   # pooled URL used at runtime
DIRECT_URL='postgresql://USER:PASSWORD@HOST:5432/postgres'                                       # direct/session URL used by prisma migrate

# --- Auth & demo ---
SESSION_SECRET='change-me-32+-random-chars'      # signs the session cookie (HS256)
DEMO_PASSWORD='Residentstart2026!'               # password for the 4 seeded demo accounts
APP_URL='http://localhost:3000'                  # public base URL (used in QR links to the simulator)

# --- Rupiah payment simulator ---
SIMULATOR_SECRET='change-me-32+-random-chars'    # HMAC key for simulator webhooks + phone simulator links
SIMULATOR_QR_LINK='true'                         # QR encodes a link to /simulator/<id> (scan with a phone); false = text payload

# --- NEAR testnet (server-side only; zero-value testnet keys) ---
NEAR_NETWORK='testnet'
NEAR_RPC_URL='https://test.rpc.fastnear.com'
NEARBLOCKS_BASE='https://testnet.nearblocks.io'
NEAR_DAO_CONTRACT='dao.residentstart.testnet'
NEAR_VAULT_CONTRACT='vault.residentstart.testnet'
NEAR_ADMIN_ACCOUNT='residentstart.testnet'       # contract owner: create_project, proposals, create_loan, record_repayment
NEAR_ADMIN_KEY='ed25519:...'
NEAR_INVESTOR1_ACCOUNT='investor1.residentstart.testnet'
NEAR_INVESTOR1_KEY='ed25519:...'
NEAR_INVESTOR2_ACCOUNT='investor2.residentstart.testnet'
NEAR_INVESTOR2_KEY='ed25519:...'

# --- Uploads (optional; without these, files go to web/public/uploads) ---
SUPABASE_URL=''
SUPABASE_SERVICE_ROLE_KEY=''
SUPABASE_BUCKET='uploads'

# --- AI agents ---
LLM_PROVIDER='mock'                              # mock | anthropic | openai  (mock needs no key)
ANTHROPIC_API_KEY=''
ANTHROPIC_MODEL='claude-opus-5-5'                # chat agents (effort low by default)
ANTHROPIC_MODEL_MARKETING='claude-opus-5-5'      # marketing JSON reports
OPENAI_API_KEY=''
OPENAI_MODEL='gpt-5-mini'
